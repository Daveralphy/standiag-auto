// Firestore security rules for StanDiag Auto. Deployed — this file is the
// source of truth for what's actually live; keep it that way rather than
// editing rules directly in the console.
//
// The one deliberately loose spot: serviceRequests/{id}/quotes/{mechanicId}
// allows the request's own car owner to update a quote document that isn't
// theirs (to mark it declined when they accept a different one). That's
// the one place this app writes into another user's data from the client.
// A callable Cloud Function would be a tighter fit for that specific write
// and is worth revisiting before this ships.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ─── Users ──────────────────────────────────────────────────────────
    // Clients may edit ordinary profile fields only. Role, credits, account
    // verification and administrative fields are server-managed.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSelf(userId) &&
        request.resource.data.keys().hasOnly([
          'uid', 'email', 'firstName', 'lastName', 'username', 'phone',
          'address', 'profilePhoto', 'createdAt', 'isFirstTime'
        ]) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email;
      allow update: if isSelf(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'lastName', 'username', 'phone', 'address',
          'profilePhoto', 'isFirstTime', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // ─── Username lookup ────────────────────────────────────────────────
    // A username → {uid, email} pairing, deliberately kept separate from
    // the full users/ profile and readable by anyone, signed in or not —
    // this is the one thing that has to be readable *before* sign-in, to
    // resolve a username-based login attempt to the email Firebase Auth
    // actually needs. Exposes only the pairing itself, never phone/address/
    // other profile fields the way opening up users/ for pre-auth reads
    // would. Writable only by the account it belongs to.
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ─── Mechanics ──────────────────────────────────────────────────────
    // Approval and visibility are server-managed. An approved mechanic may
    // update only device/location fields; an applicant cannot create a
    // public mechanic record or approve themselves.
    match /mechanics/{mechanicId} {
      allow read: if isSignedIn() &&
        (isSelf(mechanicId) || resource.data.isVisible == true);
      allow create, delete: if false;
      allow update: if isSelf(mechanicId) &&
        resource.data.approvedAt != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fcmToken', 'location'
        ]);
    }

    // ─── Mechanic applications ──────────────────────────────────────────
    // Private application details are readable by the applicant. All writes
    // and admin queue access go through verified callable functions.
    match /mechanicApplications/{applicantId} {
      allow read: if isSelf(applicantId);
      allow write: if false;
    }

    // ─── Vehicles ───────────────────────────────────────────────────────
    match /vehicles/{vehicleId} {
      allow read, update, delete: if isSignedIn() &&
          resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() &&
          request.resource.data.ownerId == request.auth.uid;
    }

    // ─── Scans ──────────────────────────────────────────────────────────
    match /scans/{scanId} {
      allow read, update, delete: if isSignedIn() &&
          resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() &&
          request.resource.data.ownerId == request.auth.uid;
    }

    // ─── Credits History ────────────────────────────────────────────────
    // An append-only ledger: the client creates entries (in the same
    // transaction as the balance update on users/{userId}.credits) and
    // reads its own, but never edits one after the fact. Delete is only
    // used by account self-deletion, wiping a user's own entries.
    //
    // NOT YET TIGHTENED — deliberately. Once Blaze/Functions are live and
    // chargeForAction/refundCredits/paystackWebhook (functions/src/
    // index.ts) are the only things granting/spending credits, this
    // should become `allow create, delete: if false` here and
    // `allow write: if isSelf(userId) && request.resource.data.credits ==
    // resource.data.credits` on users/{userId} below — locking both the
    // ledger and the balance field to server writes only. Deploying that
    // now would break CreditsNotifier.deduct()/refund()
    // (credits_provider.dart), the real-but-client-enforced fallback the
    // pilot currently depends on with no Blaze plan — so this tightening
    // must ship in the same deploy as Functions going live, not before.
    match /credits_history/{entryId} {
      allow read, delete: if isSignedIn() &&
          resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
          request.resource.data.userId == request.auth.uid;
    }

    // ─── Pending Paystack Purchases ─────────────────────────────────────
    // Written by initializePaystackTransaction and only ever read/resolved
    // by paystackWebhook — both Admin SDK, both server-side. No client
    // (buyer or otherwise) has any business reading or writing this
    // collection directly.
    match /pending_purchases/{reference} {
      allow read, write: if false;
    }

    // ─── Notifications ──────────────────────────────────────────────────
    // Read/dismiss your own; created only by trusted backend code, never
    // directly by a client.
    match /notifications/{notificationId} {
      allow read, update, delete: if isSignedIn() &&
          resource.data.userId == request.auth.uid;
      allow create: if false;
    }

    // ─── Jobs ───────────────────────────────────────────────────────────
    // Job status and lifecycle timestamps are changed only by trusted
    // callable functions. Clients may still write their narrowly scoped
    // non-lifecycle fields; neither party can promote a job by editing status.
    match /jobs/{jobId} {
      allow read: if isSignedIn() &&
          (resource.data.carOwnerId == request.auth.uid ||
           resource.data.mechanicId == request.auth.uid);
      allow create: if isSignedIn() &&
          request.resource.data.carOwnerId == request.auth.uid &&
          request.resource.data.status == 'pending';
      allow update: if isSignedIn() && (
        (resource.data.carOwnerId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'rating', 'ratingComment', 'reviewedAt'
         ])) ||
        (resource.data.mechanicId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'callAnsweredAt', 'mechanicLocation'
         ]))
      );
      allow delete: if false;
    }

    // ─── Service Requests + Quotes ──────────────────────────────────────
    // Requests themselves: readable by any signed-in user (mechanics need
    // to discover open ones), created and updated (e.g. cancelled) only by
    // the car owner who broadcast it.
    match /serviceRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
          request.resource.data.keys().hasOnly([
            'carOwnerId', 'issue', 'vehicleId', 'radiusKm',
            'targetMechanicId', 'status', 'createdAt'
          ]) &&
          request.resource.data.keys().hasAll([
            'carOwnerId', 'issue', 'vehicleId', 'radiusKm', 'status', 'createdAt'
          ]) &&
          request.resource.data.carOwnerId == request.auth.uid &&
          request.resource.data.status == 'open' &&
          request.resource.data.issue is string &&
          request.resource.data.issue.size() >= 8 &&
          request.resource.data.issue.size() <= 1000 &&
          request.resource.data.vehicleId is string &&
          request.resource.data.vehicleId.size() > 0 &&
          request.resource.data.radiusKm is number &&
          request.resource.data.radiusKm > 0 &&
          request.resource.data.radiusKm <= 100 &&
          (!('targetMechanicId' in request.resource.data) ||
            (request.resource.data.targetMechanicId is string &&
             request.resource.data.targetMechanicId.size() > 0));
      // Customers may only cancel an unresolved request from the client.
      // Matching, job links, and reopening a request are server-owned state.
      allow update: if isSignedIn() &&
          resource.data.carOwnerId == request.auth.uid &&
          resource.data.status in ['open', 'pending'] &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);

      // Quote selection and job creation are server-owned transactions.
      // Mechanics can write only their own quote; customers cannot directly
      // accept/decline quotes and bypass the single-acceptance invariant.
      match /quotes/{mechanicId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
          request.auth.uid == mechanicId &&
          get(/databases/$(database)/documents/mechanics/$(mechanicId)).data.approvedAt != null &&
          get(/databases/$(database)/documents/mechanics/$(mechanicId)).data.isVisible == true &&
          (!('targetMechanicId' in get(/databases/$(database)/documents/serviceRequests/$(requestId)).data) || get(/databases/$(database)/documents/serviceRequests/$(requestId)).data.targetMechanicId == mechanicId) &&
          get(/databases/$(database)/documents/serviceRequests/$(requestId)).data.status in ['open', 'pending'] &&
          request.resource.data.keys().hasOnly(['price', 'note', 'status', 'createdAt', 'updatedAt']) &&
          request.resource.data.keys().hasAll(['price', 'status', 'createdAt', 'updatedAt']) &&
          request.resource.data.price is number &&
          request.resource.data.price >= 0 &&
          request.resource.data.price <= 1000000000 &&
          request.resource.data.status == 'pending';
        allow update: if isSignedIn() &&
          request.auth.uid == mechanicId &&
          get(/databases/$(database)/documents/mechanics/$(mechanicId)).data.approvedAt != null &&
          get(/databases/$(database)/documents/mechanics/$(mechanicId)).data.isVisible == true &&
          (!('targetMechanicId' in get(/databases/$(database)/documents/serviceRequests/$(requestId)).data) || get(/databases/$(database)/documents/serviceRequests/$(requestId)).data.targetMechanicId == mechanicId) &&
          get(/databases/$(database)/documents/serviceRequests/$(requestId)).data.status in ['open', 'pending'] &&
          resource.data.status in ['pending', 'submitted', 'open'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['price', 'note', 'status', 'updatedAt']) &&
          request.resource.data.price is number &&
          request.resource.data.price >= 0 &&
          request.resource.data.price <= 1000000000 &&
          request.resource.data.status == 'pending';
      }
    }
  }
}
