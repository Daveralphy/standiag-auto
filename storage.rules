// Firebase Storage security rules for StanDiag Auto.
//
// DRAFT — NOT YET DEPLOYED. There was no storage.rules file in this repo
// before this one, so Storage has been running on whatever was configured
// directly in the console (almost certainly the default 30-day test-mode
// rules, the same kind that expired and briefly broke Firestore). Deploying
// this REPLACES whatever's live right now — confirm that's wanted first.
//
// Only two upload sites exist in the app right now, both simple per-user
// image uploads:
//   - profile_photos/{uid}.jpg           (car owner + mechanic profile photo)
//   - vehicle_photos/{ownerUid}/{ts}.jpg  (a vehicle's photo, nested under
//                                          its owner's own folder)
// Everything else is denied by default.

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isImageUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024 &&
          request.resource.contentType.matches('image/.*');
    }

    // Profile photos — one file per user, named "{uid}.jpg". Readable by
    // any signed-in user (shown across the app on avatars/cards), writable
    // only by that same user. The uid is everything before the literal
    // ".jpg" in the filename — Storage rules can't mix a wildcard with
    // literal text within one path segment, so the split happens in the
    // rule body instead of the path pattern.
    match /profile_photos/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
          fileName.split('.')[0] == request.auth.uid &&
          isImageUnder5MB();
    }

    // Vehicle photos — nested under the vehicle's owner's own folder, so
    // ownership is a plain path match, no string-splitting needed.
    match /vehicle_photos/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() &&
          request.auth.uid == userId &&
          isImageUnder5MB();
    }

    // Deny everything else explicitly, rather than relying on the
    // implicit default-deny — makes the "nothing else is allowed" intent
    // visible instead of assumed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
