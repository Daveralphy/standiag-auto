# Copy this file to .env and fill in real values there.
# .env is gitignored — it never gets committed, so each deployment (your
# testing, another team, the eventual brand owner) keeps its own keys
# without ever touching a tracked file.

# Agora (console.agora.io) — Project Management > your project > App ID.
# Authentication Mechanism must be set to "App ID" (no certificate) for
# calls to work, since this app has no token server. See
# lib/core/config/agora_config.dart.
AGORA_APP_ID=

# EmailJS (dashboard.emailjs.com) — emails the password-change OTP code.
# See lib/core/config/emailjs_config.dart for full setup steps.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# Firebase (console.firebase.google.com) — every value lib/firebase_options.dart
# needs, per platform. Switching this whole app to a different Firebase
# project (this dev project vs. the eventual brand owner's production
# project) is just replacing these, not hand-editing generated code.
#
# Android ALSO needs android/app/google-services.json swapped for the new
# project's copy — that file is read directly by the native Android Gradle
# plugin, not by Dart/this .env, so it can't be parameterized here. Get it
# from Firebase console > Project settings > your Android app.
#
# Get every value below from Firebase console > Project settings > General,
# under "Your apps" for each platform (Web app / Android app / iOS app).
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_MEASUREMENT_ID=

FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=

FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=

# macOS isn't a real deployment target for this app — filled in only because
# the FlutterFire CLI registered one; same values as the iOS app above.
FIREBASE_MACOS_API_KEY=
FIREBASE_MACOS_APP_ID=
FIREBASE_MACOS_BUNDLE_ID=

# Windows isn't a real deployment target either — kept working for desktop
# dev/testing only.
FIREBASE_WINDOWS_API_KEY=
FIREBASE_WINDOWS_APP_ID=
FIREBASE_WINDOWS_AUTH_DOMAIN=
FIREBASE_WINDOWS_MEASUREMENT_ID=

# Cloudinary (cloudinary.com) — stores profile and vehicle photos. Firebase
# Storage needs the paid Blaze plan just to be enabled, so images live here
# instead; Firebase's job is auth + Firestore (+ Cloud Functions, see below,
# for one thing Cloudinary itself can't do from the client). See
# lib/core/config/cloudinary_config.dart.
#
# Uploading is "unsigned" — the app posts straight from the phone with just
# the cloud name + preset name below, no API secret, no backend needed for
# that part. The security tradeoff — anyone holding these two values can
# trigger an upload — is closed off almost entirely by giving each preset a
# FIXED destination folder in step 3: Cloudinary always uses the preset's
# own folder over whatever an upload request asks for, so the worst an
# outside caller can do is add files inside that one folder — never
# overwrite an existing file (Cloudinary forces this off for every unsigned
# upload) and never touch Firestore (a photo's URL only ever reaches a real
# user's profile once written by that signed-in user, which is Firestore's
# rules' job, not Cloudinary's).
#
# Setup (free, no card required) — repeat steps 2-4 twice, once per preset:
#   1. Sign up at cloudinary.com, then go to the Dashboard — copy the "Cloud
#      name" shown at the top into CLOUDINARY_CLOUD_NAME below.
#   2. Settings > Upload > Upload presets > Add upload preset.
#   3. Set "Signing Mode" to "Unsigned" (required). Set "Folder" to a FIXED
#      value — "profile_photos" for the first preset, "vehicle_photos" for
#      the second — this is the actual security boundary, not optional.
#   4. If your plan's UI shows them, also set "Allowed formats" to
#      jpg,png,heic,webp and a max file size around 5MB — both are UX
#      niceties the app already checks client-side, this just closes the
#      same gap for a caller hitting Cloudinary directly instead of through
#      the app. Save, then copy each preset's name below.
#
# One more free hardening step, account-wide rather than per-preset: Settings
# > Security > enable "Strict transformations" — stops anyone who's found
# your cloud name from running arbitrary image transformations (resize/crop
# chains) through your account, which the app doesn't use but is a well-known
# free-tier abuse target regardless.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_PROFILE_UPLOAD_PRESET=
CLOUDINARY_VEHICLE_UPLOAD_PRESET=

# DELETING an old photo when it's replaced needs a *signed* Cloudinary
# request — that requires the API secret, which can never live in the app
# (anyone who installed it could extract it and delete/overwrite anyone
# else's photos). So deletion runs through the deleteCloudinaryImage Cloud
# Function instead, using the API secret held server-side. This is a
# separate setup step, NOT in this .env — see SETUP.md's "Deploy Cloud
# Functions" section. Requires Firebase's Blaze (pay-as-you-go) plan; the
# app still works fully without it, just without automatic cleanup of old
# photos (they'd need occasional manual deletion from Cloudinary's
# dashboard instead — search `tag:user_{uid}` or `tag:vehicle_{id}`).

# Google Sign-In — see lib/core/config/social_signin_config.dart. Full setup
# steps (and the one native file each platform also needs) are in SETUP.md's
# "Social sign-in" section.
#   1. Firebase console > Authentication > Sign-in method > enable Google.
#   2. Project settings > General > "Your apps" — the Web app's client ID is
#      GOOGLE_WEB_CLIENT_ID (used on every platform to get a Firebase-usable
#      token, not just web). The iOS app's client ID is GOOGLE_IOS_CLIENT_ID.
#   3. Android also needs a SHA-1 fingerprint added to the Android app in
#      Firebase console (Project settings > your Android app > Add
#      fingerprint) — get it with:
#      cd android && ./gradlew signingReport
#   4. iOS also needs its reversed client ID added as a URL scheme in
#      ios/Runner/Info.plist — this is the one credential here that can't
#      come from .env, since URL schemes are static. See the placeholder
#      already left there with exact instructions.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Apple Sign-In — needs an active Apple Developer Program membership
# ($99/year) to configure at all; the app works fully without it (the
# button shows a clear "not set up yet" message instead of failing
# confusingly) until then. See lib/core/config/social_signin_config.dart.
#   1. Native iOS/macOS sign-in needs NO values here at all — just the
#      "Sign in with Apple" capability added in Xcode's Signing &
#      Capabilities tab (this also wires up ios/Runner/Runner.entitlements,
#      already prepared with the right content).
#   2. Android and web go through a web sign-in flow instead, which does
#      need values here: create a Services ID under Apple Developer >
#      Certificates, Identifiers & Profiles > Identifiers, enable "Sign in
#      with Apple" on it, and set its "Return URLs" to a page you host that
#      redirects to standiagauto://oauthredirect (the scheme Android's
#      AndroidManifest.xml already listens for) — see sign_in_with_apple's
#      own docs for a ready-made redirect page template. That Services ID
#      is APPLE_SIGNIN_SERVICE_ID; the hosted page's URL is
#      APPLE_SIGNIN_REDIRECT_URI.
APPLE_SIGNIN_SERVICE_ID=
APPLE_SIGNIN_REDIRECT_URI=

# Paystack (paystack.com) — real credit purchases. Deliberately has NO entry
# here: the secret key that Paystack purchases need must never live in the
# app bundle (same reasoning as Cloudinary's API secret above), so it's set
# once as a Cloud Functions secret instead of a client .env value:
#   firebase functions:secrets:set PAYSTACK_SECRET_KEY
# See SETUP.md's "Credits & payments" section for the full setup, including
# registering the webhook URL with Paystack after first deploy. Like
# deleteCloudinaryImage, this needs Firebase's Blaze plan; until it's set up,
# Buy Credits shows a clear "not set up yet" message instead of charging
# anyone without actually being able to grant the credits.
